   "body": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ae8077837254162ed0831e5\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/a7017215-5bf6-49ab-84eb-1a4e39debf09_1045/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/a7017215-5bf6-49ab-84eb-1a4e39debf09_1045/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"6f754fc0c42cf1cc952c\" id=\"block-6f754fc0c42cf1cc952c\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Join us this week for a beautiful stroll along the Mattapoisett rail trail where we will kick off our walk for warmth, our second winter giving initiative where we will begin collecting winter hats, gloves, and scarves for children in our community in partnership with the New Bedford Y!</p></div>\n\n\n  \n<style id=\"container-styles\">#block-6f754fc0c42cf1cc952c {\n    \n    --stroke-style: none;--stroke-thickness: 2px;\n    \n      --tweak-text-block-stroke-color: hsla(var(--black-hsl), 1)\n;\n      \n      \n      \n    \n\n\n\n  }\n\n  #block-6f754fc0c42cf1cc952c .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-6f754fc0c42cf1cc952c {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-6f754fc0